# Explicitly exclude root and nested Git metadata.
.git
.git/**
**/.git
**/.git/**
**/.git/**

# Exclude local Wrangler and dependency artifacts.
.wrangler
.wrangler/**
**/.wrangler
**/.wrangler/**
node_modules
node_modules/**
**/node_modules
**/node_modules/**

# Exclude local secrets and environment files.
.env
.env.*
.dev.vars
.dev.vars.*

# Worker source and deployment configuration are not public assets.
worker.js
wrangler.jsonc
.assetsignore
.gitignore
