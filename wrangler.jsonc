{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cineva4",
  "main": "worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/movie/*",
      "/series/*"
    ]
  }
}
